{
  "realm": "contract-processing",
  "enabled": true,
  "roles": {"realm": [{"name": "submitter"}, {"name": "reviewer"}, {"name": "administrator"}]},
  "clients": [{
    "clientId": "contract-processing-api",
    "name": "Contract Processing Local API",
    "enabled": true,
    "publicClient": true,
    "directAccessGrantsEnabled": true,
    "standardFlowEnabled": true,
    "redirectUris": ["http://localhost:8000/*"],
    "webOrigins": ["http://localhost:8000"],
    "protocolMappers": [{
      "name": "api-audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "config": {"included.client.audience": "contract-processing-api", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false"}
    }]
  }],
  "users": [
    {"username": "submitter", "email": "submitter@example.test", "emailVerified": true, "firstName": "Local", "lastName": "Submitter", "enabled": true, "credentials": [{"type": "password", "value": "Submit123!", "temporary": false}], "realmRoles": ["submitter"]},
    {"username": "reviewer", "email": "reviewer@example.test", "emailVerified": true, "firstName": "Local", "lastName": "Reviewer", "enabled": true, "credentials": [{"type": "password", "value": "Review123!", "temporary": false}], "realmRoles": ["reviewer"]},
    {"username": "administrator", "email": "administrator@example.test", "emailVerified": true, "firstName": "Local", "lastName": "Administrator", "enabled": true, "credentials": [{"type": "password", "value": "Admin123!", "temporary": false}], "realmRoles": ["administrator"]}
  ]
}
